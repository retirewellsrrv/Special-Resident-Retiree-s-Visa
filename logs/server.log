4\t  | 'credit_card'\n35\t  | 'debit_card'\n36\t  | 'e-wallet'\n37\t\n38\texport type ServiceType =\n39\t  | 'basic'\n40\t  | 'premium'\n41\t  | 'vip'\n42\t\n43\t// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n44\t// TABLE ROWS\n45\t// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n46\t\n47\texport interface UserRow {\n48\t  id: string\n49\t  email: string\n50\t  password: string\n51\t  created_at: string\n52\t}\n53\t\n54\texport interface AdminProfileRow {\n55\t  user_id: string\n56\t  name: string\n57\t}\n58\t\n59\texport interface ClientProfileRow {\n60\t  user_id: string\n61\t  name: string\n62\t  sex: Sex | null\n63\t  birthday: string | null\n64\t  nationality: string\n65\t  age: number | null\n66\t  address: string\n67\t}\n68\t\n69\texport interface ServiceRow {\n70\t  id: number\n71\t  type: ServiceType\n72\t  price: number | null\n73\t  description: string | null\n74\t  is_available: boolean | null\n75\t}\n76\t\n77\texport interface PaymentRow {\n78\t  id: number\n79\t  user_id: string\n80\t  status: PaymentStatus\n81\t  amount: number | null\n82\t  transaction_code: string\n83\t  payment_method: PaymentMethods | null\n84\t  created_at: string | null\n85\t  updated_at: string | null\n86\t}\n87\t\n88\texport interface NotificationRow {\n89\t  id: number\n90\t  user_id: string\n91\t  notification: string\n92\t  is_read: boolean\n93\t}\n94\t\n95\texport interface ApplicationRow {\n96\t  id: number\n97\t  user_id: string\n98\t  service_type: ServiceType\n99\t  application_code: string\n100\t  status: ApplicationStatus\n101\t  created_at: string | null\n102\t  updated_at: string | null\n103\t}\n104\t\n105\texport interface DocumentRow {\n106\t  id: number\n107\t  application_id: number\n108\t  path: string\n109\t  type: string | null\n110\t  status: DocumentStatus | null\n111\t  created_at: string | null\n112\t  updated_at: string | null\n113\t}\n114\t\n115\t// for review\n116\texport interface MessageRow {\n117\t  id: number\n118\t  sender_id: string\n119\t  receiver_id: string\n120\t  message: string\n121\t  created_at: string\n122\t}\n123\t\n124\t// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n125\t// INSERT TYPES\n126\t// \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n127\t\n128\texport interface UserInsert {\n129\t  email: string\n130\t  password: string\n131\t}\n132\t\n133\texport interface AdminProfileInsert {\n134\t  user_id: string\n135\t  name: string\n136\t}\n137\t\n138\texport interface ClientProfileInsert {\n139\t  user_id: string\n140\t  name: string\n141\t  sex: Sex | null\n142\t  birthday: string | null\n143\t  nationality: string\n144\t  age: number | null\n145\t  address: string\n146\t}\n147\t\n148\texport interface ServiceInsert {\n149\t  type: ServiceType\n150\t  price: number | null\n151\t  description: string | null\n152\t  is_available: boolean | null\n153\t}\n154\t\n155\texport interface PaymentInsert {\n156\t  user_id: string\n157\t  status: PaymentStatus\n158\t  amount: number | null\n159\t  transaction_code: string\n160\t  payment_method: PaymentMethods | null\n161\t}\n162\t\n163\texport interface Notification