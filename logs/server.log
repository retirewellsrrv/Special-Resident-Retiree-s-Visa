ase verify your email before logging in.\n\n\u001b[90mstdout\u001b[2m | src/__tests__/auth.actions.test.ts\u001b[2m > \u001b[22m\u001b[2mregisterAction\u001b[2m > \u001b[22m\u001b[2mshould handle signUp error gracefully\n\u001b[22m\u001b[39mJohn Doe\nduplicate@example.com\n1990-01-01\n\n\u001b[90mstderr\u001b[2m | src/__tests__/auth.actions.test.ts\u001b[2m > \u001b[22m\u001b[2mregisterAction\u001b[2m > \u001b[22m\u001b[2mshould handle signUp error gracefully\n\u001b[22m\u001b[39msignup error: { message: \u001b[32m'User already exists'\u001b[39m }\n\n\u001b[90mstdout\u001b[2m | src/__tests__/auth.actions.test.ts\u001b[2m > \u001b[22m\u001b[2mregisterAction\u001b[2m > \u001b[22m\u001b[2mshould return error if user creation fails\n\u001b[22m\u001b[39mJohn Doe\nfail@example.com\n1990-01-01\n\n \u001b[31m\u276f\u001b[39m src/__tests__/auth.actions.test.ts \u001b[2m(\u001b[22m\u001b[2m16 tests\u001b[22m\u001b[2m | \u001b[22m\u001b[31m2 failed\u001b[39m\u001b[2m)\u001b[22m\u001b[90m 19\u001b[2mms\u001b[22m\u001b[39m\n\u001b[31m   \u001b[31m\u00d7\u001b[31m registerAction\u001b[2m > \u001b[22mshould capitalize first name and surname correctly\u001b[90m 5\u001b[2mms\u001b[22m\u001b[31m\u001b[39m\n\u001b[31m     \u2192 Cannot read properties of undefined (reading 'signUp')\u001b[39m\n\u001b[31m   \u001b[31m\u00d7\u001b[31m logoutAction\u001b[2m > \u001b[22mshould successfully logout\u001b[90m 1\u001b[2mms\u001b[22m\u001b[31m\u001b[39m\n\u001b[31m     \u2192 Redirect\u001b[39m\n\n\u001b[31m\u23af\u23af\u23af\u23af\u23af\u23af\u23af\u001b[1m\u001b[7m Failed Tests 4 \u001b[27m\u001b[22m\u23af\u23af\u23af\u23af\u23af\u23af\u23af\u001b[39m\n\n\u001b[31m\u001b[1m\u001b[7m FAIL \u001b[27m\u001b[22m\u001b[39m src/__tests__/auth.actions.test.ts\u001b[2m > \u001b[22mregisterAction\u001b[2m > \u001b[22mshould capitalize first name and surname correctly\n\u001b[31m\u001b[1mTypeError\u001b[22m: Cannot read properties of undefined (reading 'signUp')\u001b[39m\n\u001b[36m \u001b[2m\u276f\u