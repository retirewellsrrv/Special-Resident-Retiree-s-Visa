sert: PaymentInsert\n255\t        Update: PaymentUpdate\n256\t        Relationships: [\n257\t          {\n258\t            foreignKeyName: 'payments_user_id_fkey'\n259\t            columns: ['user_id']\n260\t            isOneToOne: false\n261\t            referencedRelation: 'users'\n262\t            referencedColumns: ['id']\n263\t          }\n264\t        ]\n265\t      }\n266\t      notifications: {\n267\t        Row: NotificationRow\n268\t        Insert: NotificationInsert\n269\t        Update: NotificationUpdate\n270\t        Relationships: [\n271\t          {\n272\t            foreignKeyName: 'notifications_user_id_fkey'\n273\t            columns: ['user_id']\n274\t            isOneToOne: false\n275\t            referencedRelation: 'users'\n276\t            referencedColumns: ['id']\n277\t          }\n278\t        ]\n279\t      }\n280\t      applications: {\n281\t        Row: ApplicationRow\n282\t        Insert: ApplicationInsert\n283\t        Update: ApplicationUpdate\n284\t        Relationships: [\n285\t          {\n286\t            foreignKeyName: 'applications_user_id_fkey'\n287\t            columns: ['user_id']\n288\t            isOneToOne: false\n289\t            referencedRelation: 'users'\n290\t            referencedColumns: ['id']\n291\t          },\n292\t          {\n293\t            foreignKeyName: 'applications_service_type_fkey'\n294\t            columns: ['service_type']\n295\t            isOneToOne: false\n296\t            referencedRelation: 'services'\n297\t            referencedColumns: ['type']\n298\t          }\n299\t        ]\n300\t      }\n301\t      documents: {\n302\t        Row: DocumentRow\n303\t        Insert: DocumentInsert\n304\t        Update: DocumentUpdate\n305\t        Relationships: [\n306\t          {\n307\t            foreignKeyName: 'documents_application_id_fkey'\n308\t            columns: ['application_id']\n309\t            isOneToOne: false\n310\t            referencedRelation: 'applications'\n311\t            referenced